<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.AiAgent" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:statusBarColor">?colorSurface</item>
        <item name="android:navigationBarColor">?colorSurface</item>
        <item name="android:windowLightStatusBar">?isLightTheme</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">?isLightTheme</item>
        <item name="fontFamily">@font/josefin_sans</item>
        <item name="android:fontFamily">@font/josefin_sans</item>
    </style>


    <!-- Base application theme (Material3 DayNight) -->
    <style name="Theme.AiAgent" parent="Base.Theme.AiAgent">
        <!-- Primary -->
        <item name="colorPrimary">@color/karbon_primary</item>
        <item name="colorOnPrimary">@color/karbon_on_primary</item>
        <item name="colorPrimaryContainer">@color/karbon_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/karbon_on_primary_container</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/karbon_secondary</item>
        <item name="colorOnSecondary">@color/karbon_on_secondary</item>
        <item name="colorSecondaryContainer">@color/karbon_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/karbon_on_secondary_container</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/karbon_tertiary</item>
        <item name="colorOnTertiary">@color/karbon_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/karbon_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/karbon_on_tertiary_container</item>

        <!-- Error -->
        <item name="colorError">@color/karbon_error</item>
        <item name="colorErrorContainer">@color/karbon_error_container</item>
        <item name="colorOnError">@color/karbon_on_error</item>
        <item name="colorOnErrorContainer">@color/karbon_on_error_container</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/karbon_background</item>
        <item name="colorOnBackground">@color/karbon_on_background</item>
        <item name="colorSurface">@color/karbon_surface</item>
        <item name="colorOnSurface">@color/karbon_on_surface</item>
        <item name="colorSurfaceVariant">@color/karbon_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/karbon_on_surface_variant</item>

        <!-- Outline -->
        <item name="colorOutline">@color/karbon_outline</item>
        <item name="colorOutlineVariant">@color/karbon_outline_variant</item>

        <!-- Inverse colors -->
        <item name="colorPrimaryInverse">@color/karbon_inverse_primary</item>
        <item name="colorSurfaceInverse">@color/karbon_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/karbon_inverse_on_surface</item>

    </style>

</resources>